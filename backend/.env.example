# Copy to .env and edit. MySQL database must exist (see README).
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/bug_diagnosis
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
CORS_ORIGINS=http://localhost:4200

# ---- Knowledge base (M1.4) ----
DATA_DIR=data
CHROMA_DIR=chroma_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
APACHE_SAMPLE_SIZE=10000
APACHE_DUPLICATE_PAIRS=300
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
